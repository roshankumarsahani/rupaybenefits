rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A user can read and write only their own workspace document.
    match /users/{userId}/workspace/{documentId} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && documentId == "main";

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && documentId == "main"
        && request.resource.data.keys().hasOnly([
          "cards",
          "vouchers",
          "variants",
          "holders",
          "benefitUsages",
          "benefitCatalog",
          "updatedAt"
        ])
        && request.resource.data.cards is list
        && request.resource.data.vouchers is list
        && (!("variants" in request.resource.data) || request.resource.data.variants is list)
        && (!("holders" in request.resource.data) || request.resource.data.holders is list)
        && (!("benefitUsages" in request.resource.data) || request.resource.data.benefitUsages is list)
        && (!("benefitCatalog" in request.resource.data) || request.resource.data.benefitCatalog is list);

      allow delete: if false;
    }
  }
}