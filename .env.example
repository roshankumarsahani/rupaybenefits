# Copy to .env on the Oracle Cloud server. Never commit real values.
NODE_ENV=production
PORT=3000
POSTGRES_DB=rupay_benefits
POSTGRES_USER=rupay_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://rupay_app:replace-with-a-long-random-password@db:5432/rupay_benefits
PGSSLMODE=disable
# Exact HTTPS browser origin, e.g. https://benefits.example.com
APP_ORIGINS=https://your-domain.example
SESSION_COOKIE_NAME=rb_session
SESSION_DAYS=7
SESSION_COOKIE_SECURE=true
